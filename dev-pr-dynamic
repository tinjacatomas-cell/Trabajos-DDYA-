      "source": [
        "def suscriptores(n, memorizacion):\n",
        "\n",
        "\n",
        "    if n == 0:\n",
        "        return 0\n",
        "\n",
        "    if n == 1:\n",
        "        return 1\n",
        "\n",
        "\n",
        "    if memorizacion[n] != -1:\n",
        "\n",
        "        return memorizacion[n]\n",
        "\n",
        "\n",
        "    memorizacion[n] = suscriptores(n - 1, memorizacion) + suscriptores(n - 2, memorizacion)\n",
        "\n",
        "    return memorizacion[n]\n",
        "\n",
        "\n",
        "def main():\n",
        "\n",
        "\n",
        "  n = int(input(\"Ingrese la cantidad de meses que desea evaluar:\" ))\n",
        "\n",
        "  memorizacion = [-1] * (n + 1)\n",
        "\n",
        "  subs = suscriptores(n,memorizacion)\n",
        "\n",
        "\n",
        "  print(\"La cantidad de suscriptores nuevos en\",n,\" meses es =\",subs)\n",
        "\n",
        "  if n == 0:\n",
        "\n",
        "    print(\"Ingrese un numero valido de meses :)\")\n",
