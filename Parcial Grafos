        "def buscar_ruta_corregida(grafo, origen, destino):\n",
        "    cola = [origen]\n",
        "    visitados = [origen]\n",
        "    anteriores = {origen: None}\n",
        "\n",
        "    while len(cola) > 0:\n",
        "        estacion = cola.pop(0)\n",
        "        if estacion == destino:\n",
        "            break\n",
        "        for vecino in grafo[estacion]:\n",
        "            if vecino not in visitados:\n",
        "                visitados.append(vecino)\n",
        "                cola.append(vecino)\n",
        "                anteriores[vecino] = estacion\n",
        "\n",
        "    if destino not in anteriores:\n",
        "        print(\"No existe una ruta entre las estaciones.\")\n",
        "        return None\n",
        "\n",
        "    ruta = []\n",
        "    estacion = destino\n",
        "    while estacion is not None:\n",
        "        ruta.append(estacion)\n",
        "        estacion = anteriores[estacion]\n",
        "    ruta.reverse()\n",
        "\n",
        "    print(\"\\n===== RUTA MAS CORTA =====\")\n",
        "    print(\" -> \".join(ruta))\n",
        "    print(\"Cantidad de conexiones:\", len(ruta) - 1)\n",
